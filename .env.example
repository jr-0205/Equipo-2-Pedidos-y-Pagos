# URLs BASE de los otros equipos. Sustituye las IPs por las IPv4 reales.
# Equipo 1: Clientes 3001 y Productos 3002.
# Equipo 3: Inventario 20002 y Notificaciones 20003.
# No agregues rutas al final de estas URLs. Déjalas vacías si el equipo no está disponible.
CLIENTES_URL=
PRODUCTOS_URL=
INVENTARIO_URL=
NOTIFICACIONES_URL=

# Tiempo máximo para llamadas HTTP externas, en milisegundos.
REQUEST_TIMEOUT_MS=5000

# Puerto publicado de PostgreSQL en Windows.
POSTGRES_HOST_PORT=5433
