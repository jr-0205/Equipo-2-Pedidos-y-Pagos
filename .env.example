# Equipo 2 - Pedidos y Pagos
# Copia este archivo como .env antes de ejecutar:  Copy-Item .env.example .env
#
# ---------------------------------------------------------------------------
# 1) PUERTOS PUBLICADOS en esta computadora (lado izquierdo de "publicado:interno").
#    El acuerdo entre los tres equipos es 2503 (pedidos), 2504 (pagos) y 5433
#    (PostgreSQL, solo administración). Cambia un valor solo si el puerto ya está
#    ocupado en esta PC y AVISA a los otros equipos.
# ---------------------------------------------------------------------------
PEDIDOS_HOST_PORT=2503
PAGOS_HOST_PORT=2504
POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------------------
# 2) URLs DE LOS OTROS EQUIPOS (con IP + puerto PUBLICADO).
#    Sustituye IP-EQUIPO-1 / IP-EQUIPO-3 por la IPv4 real de esas computadoras
#    (se obtiene con "ipconfig" en la máquina de cada equipo).
#    MUY IMPORTANTE: nunca uses localhost aquí; dentro del contenedor localhost
#    es el propio contenedor, no la otra computadora.
#    Si dejas una URL vacía, esa integración se omite y /gateway/status lo reporta.
# ---------------------------------------------------------------------------
CLIENTES_URL=http://IP-EQUIPO-1:2501
PRODUCTOS_URL=http://IP-EQUIPO-1:2502
INVENTARIO_URL=http://IP-EQUIPO-3:2506
NOTIFICACIONES_URL=http://IP-EQUIPO-3:2507

# ---------------------------------------------------------------------------
# 3) Tiempo máximo de espera de las llamadas HTTP a otros equipos (milisegundos).
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# 4) Credenciales locales de PostgreSQL (opcionales; hay valores por defecto).
#    Cámbialas si el proyecto se publica fuera del laboratorio.
# ---------------------------------------------------------------------------
POSTGRES_USER=tienda
POSTGRES_PASSWORD=tienda123
