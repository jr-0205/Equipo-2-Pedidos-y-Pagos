# URLs base de los microservicios de los otros equipos.
# Ejemplo para cuando los seis microservicios están publicados en la VM 192.168.100.250.
# Si algún equipo está en otra computadora, cambia SOLO la IP de ese servicio.
CLIENTES_URL=http://192.168.100.250:2501
PRODUCTOS_URL=http://192.168.100.250:2502
INVENTARIO_URL=http://192.168.100.250:2506
NOTIFICACIONES_URL=http://192.168.100.250:2507

REQUEST_TIMEOUT_MS=5000

# Puerto local de PostgreSQL para administración; no es un microservicio público.
POSTGRES_HOST_PORT=5433
