# URLs base de los microservicios de los otros equipos.
# IMPORTANTE: sustituye los valores IP_EQUIPO_* por las IP reales de tu LAN
# en el archivo local .env (no subas las IP privadas de tu red a GitHub).
CLIENTES_URL=http://IP_EQUIPO_1:2501
PRODUCTOS_URL=http://IP_EQUIPO_1:2502
INVENTARIO_URL=http://IP_EQUIPO_3:2506
NOTIFICACIONES_URL=http://IP_EQUIPO_3:2507

REQUEST_TIMEOUT_MS=5000

# Puerto local de PostgreSQL para administración; no es un microservicio público.
POSTGRES_HOST_PORT=5433
