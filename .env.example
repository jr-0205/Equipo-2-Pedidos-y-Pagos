# URLs BASE de los otros equipos.
# IMPORTANTE: no agregues /clientes, /productos, /inventario ni /notificaciones.
# Correcto:   http://192.168.6.63:3001
# Incorrecto: http://192.168.6.63:3001/clientes
#
# Déjalas vacías si todavía no está disponible ese equipo.
CLIENTES_URL=
PRODUCTOS_URL=
INVENTARIO_URL=
NOTIFICACIONES_URL=

# Tiempo máximo para llamadas HTTP externas, en milisegundos.
REQUEST_TIMEOUT_MS=5000

# Puerto publicado de PostgreSQL en Windows.
POSTGRES_HOST_PORT=5433
