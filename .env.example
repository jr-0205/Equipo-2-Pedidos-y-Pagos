# URLs base de los microservicios de los otros equipos.
# Si los equipos se ejecutan en la misma VM Linux, Productos usa el host gateway.
CLIENTES_URL=
PRODUCTOS_URL=http://host.docker.internal:2502
INVENTARIO_URL=
NOTIFICACIONES_URL=

REQUEST_TIMEOUT_MS=5000

# Puerto local de PostgreSQL para administración; no es un microservicio público.
POSTGRES_HOST_PORT=5433
